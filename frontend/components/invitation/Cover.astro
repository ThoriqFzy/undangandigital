---
/**
 * COVER SECTION — Opening visual anchor
 * Source: REFERENCE.md Section 8
 * 
 * Full-screen cover with:
 * - Decorative background
 * - Event label
 * - Couple names
 * - Date
 * - CTA "Buka Undangan"
 */

interface Props {
  groomName: string;
  brideName: string;
  weddingDate: string;
  guestName?: string;
  title?: string;
}

const { groomName, brideName, weddingDate, guestName, title } = Astro.props;

// Format date: "10 Oktober 2026"
const formattedDate = new Date(weddingDate).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section
  id="cover"
  class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-6 text-center"
  style="background: linear-gradient(180deg, var(--color-background) 0%, var(--color-surface-soft) 100%);"
>
  {/* Decorative floral top */}
  <div class="pointer-events-none absolute inset-x-0 top-0 flex justify-center opacity-30">
    <svg width="200" height="120" viewBox="0 0 200 120" fill="none" class="text-[var(--color-primary-soft)]">
      <path d="M100 10 C60 10 20 40 10 80 C30 50 60 30 100 30 C140 30 170 50 190 80 C180 40 140 10 100 10Z" fill="currentColor" opacity="0.5"/>
      <path d="M100 20 C70 20 40 45 30 75 C45 55 70 40 100 40 C130 40 155 55 170 75 C160 45 130 20 100 20Z" fill="currentColor" opacity="0.3"/>
      <circle cx="60" cy="50" r="3" fill="currentColor" opacity="0.4"/>
      <circle cx="140" cy="50" r="3" fill="currentColor" opacity="0.4"/>
      <circle cx="100" cy="35" r="2" fill="currentColor" opacity="0.4"/>
    </svg>
  </div>

  {/* Event label */}
  <p class="mb-3 font-[family-name:var(--font-accent)] text-lg text-[var(--color-accent)]">
    The Wedding of
  </p>

  {/* Couple names */}
  <h1 class="mb-2 font-[family-name:var(--font-display)] text-4xl font-semibold leading-tight text-[var(--color-text)] md:text-5xl">
    {groomName}
  </h1>
  <p class="mb-2 font-[family-name:var(--font-accent)] text-3xl text-[var(--color-primary)]">&</p>
  <h1 class="mb-6 font-[family-name:var(--font-display)] text-4xl font-semibold leading-tight text-[var(--color-text)] md:text-5xl">
    {brideName}
  </h1>

  {/* Date */}
  <p class="mb-8 text-sm tracking-widest text-[var(--color-text-muted)] uppercase">
    {formattedDate}
  </p>

  {/* Guest greeting (if personalized) */}
  {guestName && (
    <div class="mb-6 rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-surface)]/80 px-6 py-3 backdrop-blur-sm">
      <p class="text-xs text-[var(--color-text-muted)]">Kepada Yth.</p>
      <p class="font-[family-name:var(--font-heading)] text-lg font-medium text-[var(--color-text)]">
        {guestName}
      </p>
    </div>
  )}

  {/* CTA Button */}
  <button
    id="open-invitation"
    class="group flex items-center gap-2 rounded-full bg-[var(--color-primary)] px-8 py-3.5 text-sm font-medium text-white shadow-lg transition-all duration-300 hover:bg-[var(--color-primary-dark)] hover:shadow-xl active:scale-95"
  >
    <span>Buka Undangan</span>
    <svg class="h-4 w-4 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  {/* Decorative floral bottom */}
  <div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-center rotate-180 opacity-20">
    <svg width="160" height="80" viewBox="0 0 160 80" fill="none" class="text-[var(--color-primary-soft)]">
      <path d="M80 5 C50 5 20 30 10 60 C25 40 50 25 80 25 C110 25 135 40 150 60 C140 30 110 5 80 5Z" fill="currentColor" opacity="0.6"/>
    </svg>
  </div>
</section>

<script>
  // Smooth scroll to first content section when CTA is clicked
  document.getElementById('open-invitation')?.addEventListener('click', () => {
    document.getElementById('quote')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>

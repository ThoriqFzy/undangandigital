---
/**
 * STORY / LOVE STORY SECTION
 * Source: REFERENCE.md Section 13
 */

interface StoryItem {
  yearLabel: string | null;
  title: string;
  description: string | null;
  imageUrl: string | null;
}

interface Props {
  stories: StoryItem[];
}

const { stories } = Astro.props;
---

<section id="story" class="invitation-section bg-[var(--color-background)]">
  <div class="mx-auto max-w-sm space-y-8">
    {/* Section heading */}
    <div class="text-center">
      <p class="mb-1 font-[family-name:var(--font-accent)] text-base text-[var(--color-accent)]">Perjalanan Cinta</p>
      <h2 class="font-[family-name:var(--font-heading)] text-2xl font-semibold text-[var(--color-text)]">Love Story</h2>
    </div>

    {/* Timeline */}
    <div class="relative space-y-8 pl-8">
      {/* Vertical line */}
      <div class="absolute left-3 top-2 bottom-2 w-px bg-[var(--color-border)]"></div>

      {stories.map((story, index) => (
        <div class="relative">
          {/* Dot */}
          <div class="absolute -left-5 top-1 h-3 w-3 rounded-full border-2 border-[var(--color-primary)] bg-[var(--color-surface)]"></div>

          {/* Year badge */}
          {story.yearLabel && (
            <span class="mb-2 inline-block rounded-full bg-[var(--color-primary)]/10 px-3 py-0.5 text-xs font-medium text-[var(--color-primary)]">
              {story.yearLabel}
            </span>
          )}

          {/* Story card */}
          <div class="rounded-xl border border-[var(--color-border-soft)] bg-[var(--color-surface)] p-4 shadow-sm">
            {story.imageUrl && (
              <img
                src={story.imageUrl}
                alt={story.title}
                class="mb-3 h-40 w-full rounded-lg object-cover"
                loading="lazy"
              />
            )}
            <h3 class="mb-1 font-[family-name:var(--font-heading)] text-lg font-semibold text-[var(--color-text)]">
              {story.title}
            </h3>
            {story.description && (
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
                {story.description}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

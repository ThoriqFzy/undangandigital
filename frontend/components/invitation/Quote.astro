---
/**
 * QUOTE / VERSE SECTION
 * Source: REFERENCE.md Section 14
 */

interface Props {
  text?: string;
  source?: string;
}

const {
  text = "Dan di antara tanda-tanda kekuasaan-Nya ialah Dia menciptakan untukmu pasangan hidup dari jenismu sendiri, supaya kamu cenderung dan merasa tenteram kepadanya.",
  source = "QS. Ar-Rum : 21"
} = Astro.props;
---

<section id="quote" class="invitation-section bg-[var(--color-background)]">
  <div class="mx-auto max-w-sm text-center">
    {/* Decorative divider */}
    <div class="mb-6 flex items-center justify-center gap-3">
      <div class="h-px w-12 bg-[var(--color-accent)]"></div>
      <svg class="h-5 w-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
      <div class="h-px w-12 bg-[var(--color-accent)]"></div>
    </div>

    {/* Quote text */}
    <p class="mb-4 font-[family-name:var(--font-heading)] text-base italic leading-relaxed text-[var(--color-text-muted)]">
      &ldquo;{text}&rdquo;
    </p>

    {/* Source */}
    <p class="text-xs font-medium tracking-wider text-[var(--color-accent)]">
      — {source}
    </p>
  </div>
</section>

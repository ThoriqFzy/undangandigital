---
/**
 * INVITATION EDIT — Manage a single invitation
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '@db/client';
import { invitations, couples, events, stories, gifts, guests } from '@db/index';
import { and, eq, isNull, count as drizzleCount } from 'drizzle-orm';

const ownerId = Astro.locals.adminUser!.id;
const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/invitations');

const invitation = await db.query.invitations.findFirst({
  where: and(eq(invitations.id, id), eq(invitations.ownerId, ownerId), isNull(invitations.deletedAt)),
  with: { template: true, theme: true, couple: true },
});

if (!invitation) return Astro.redirect('/admin/invitations');

const [eventCount] = await db.select({ count: drizzleCount() }).from(events).where(eq(events.invitationId, id));
const [storyCount] = await db.select({ count: drizzleCount() }).from(stories).where(eq(stories.invitationId, id));
const [giftCount] = await db.select({ count: drizzleCount() }).from(gifts).where(eq(gifts.invitationId, id));
const [guestCountResult] = await db.select({ count: drizzleCount() }).from(guests).where(and(eq(guests.invitationId, id), isNull(guests.deletedAt)));

const statusColors: Record<string, string> = {
  draft: 'bg-gray-100 text-gray-700',
  published: 'bg-green-100 text-green-700',
  archived: 'bg-amber-100 text-amber-700',
};

const statusLabels: Record<string, string> = {
  draft: 'Draft',
  published: 'Dipublikasikan',
  archived: 'Diarsipkan',
};
---

<AdminLayout title={`Edit: ${invitation.title || invitation.slug}`} activePage="invitations">
  <div class="space-y-6">
    {/* Header with status */}
    <div class="flex items-center justify-between">
      <div>
        <a href="/admin/invitations" class="mb-2 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
          Kembali
        </a>
        <h2 class="text-xl font-bold text-gray-900">{invitation.title || invitation.slug}</h2>
        <p class="text-sm text-gray-500">/{invitation.slug}</p>
      </div>
      <div class="flex items-center gap-2">
        <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${statusColors[invitation.status]}`}>
          {statusLabels[invitation.status]}
        </span>
        <a href={`/${invitation.slug}`} target="_blank" class="rounded-lg border border-gray-200 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
          Lihat →
        </a>
      </div>
    </div>

    {/* Quick stats */}
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-gray-200 bg-white p-3 text-center">
        <p class="text-lg font-bold text-gray-900">{guestCountResult.count}</p>
        <p class="text-xs text-gray-500">Tamu</p>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-3 text-center">
        <p class="text-lg font-bold text-gray-900">{eventCount.count}</p>
        <p class="text-xs text-gray-500">Acara</p>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-3 text-center">
        <p class="text-lg font-bold text-gray-900">{storyCount.count}</p>
        <p class="text-xs text-gray-500">Cerita</p>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-3 text-center">
        <p class="text-lg font-bold text-gray-900">{giftCount.count}</p>
        <p class="text-xs text-gray-500">Hadiah</p>
      </div>
    </div>

    {/* Quick links */}
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <a href={`/admin/invitations/${id}/couple`} class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-pink-50 text-pink-600">💑</div>
        <div>
          <p class="text-sm font-medium text-gray-900">Data Mempelai</p>
          <p class="text-xs text-gray-500">{invitation.couple ? `${invitation.couple.groomName} & ${invitation.couple.brideName}` : 'Belum diisi'}</p>
        </div>
      </a>
      <a href={`/admin/invitations/${id}/events`} class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600">📅</div>
        <div>
          <p class="text-sm font-medium text-gray-900">Acara</p>
          <p class="text-xs text-gray-500">{eventCount.count} acara</p>
        </div>
      </a>
      <a href={`/admin/invitations/${id}/stories`} class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600">📖</div>
        <div>
          <p class="text-sm font-medium text-gray-900">Cerita Cinta</p>
          <p class="text-xs text-gray-500">{storyCount.count} item</p>
        </div>
      </a>
      <a href={`/admin/invitations/${id}/gallery`} class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-50 text-purple-600">🖼️</div>
        <div>
          <p class="text-sm font-medium text-gray-900">Galeri</p>
          <p class="text-xs text-gray-500">Upload foto</p>
        </div>
      </a>
      <a href={`/admin/guests?invitation=${id}`} class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-green-50 text-green-600">👥</div>
        <div>
          <p class="text-sm font-medium text-gray-900">Tamu</p>
          <p class="text-xs text-gray-500">{guestCountResult.count} tamu</p>
        </div>
      </a>
      <a href={`/admin/invitations/${id}/gifts`} class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-rose-50 text-rose-600">🎁</div>
        <div>
          <p class="text-sm font-medium text-gray-900">Hadiah</p>
          <p class="text-xs text-gray-500">{giftCount.count} rekening</p>
        </div>
      </a>
    </div>
  </div>
</AdminLayout>

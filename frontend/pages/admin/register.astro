---
/**
 * REGISTER PAGE — Create admin account
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import RegisterForm from '../../components/admin/RegisterForm.tsx';
import { getCurrentUser } from '../../../backend/auth/config';

// Redirect if already logged in
const user = await getCurrentUser(Astro.request);
if (user) {
  return Astro.redirect('/admin');
}
---

<BaseLayout title="Register — Admin">
  <div class="flex min-h-dvh items-center justify-center bg-gray-50 px-4">
    <div class="w-full max-w-sm">
      {/* Logo */}
      <div class="mb-8 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-600 text-lg font-bold text-white">W</div>
        <h1 class="mt-3 text-xl font-bold text-gray-900">Buat Akun Admin</h1>
        <p class="mt-1 text-sm text-gray-500">Daftar untuk mengelola undangan</p>
      </div>

      {/* Register form */}
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <RegisterForm client:load />
      </div>

      {/* Login link */}
      <p class="mt-4 text-center text-sm text-gray-500">
        Sudah punya akun?
        <a href="/admin/login" class="font-medium text-indigo-600 hover:text-indigo-700"> Login</a>
      </p>
    </div>
  </div>
</BaseLayout>

---
/**
 * SETTINGS PAGE — Application settings
 * Placeholder for Phase 6 (auth integration).
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Pengaturan" activePage="settings">
  <div class="space-y-6">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-900">Pengaturan Akun</h3>
      <p class="mt-1 text-sm text-gray-500">Fitur ini akan tersedia setelah integrasi autentikasi (Phase 6).</p>
      <div class="mt-4 rounded-lg bg-gray-50 p-4">
        <p class="text-sm text-gray-600">Status: <span class="font-medium text-amber-600">Coming Soon</span></p>
        <p class="mt-1 text-xs text-gray-500">Better Auth integration untuk login/register admin.</p>
      </div>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-gray-900">Database Info</h3>
      <div class="mt-3 space-y-2 text-sm text-gray-600">
        <p>Provider: <span class="font-medium">Neon PostgreSQL</span></p>
        <p>ORM: <span class="font-medium">Drizzle</span></p>
        <p>Status: <span class="font-medium text-green-600">Connected ✓</span></p>
      </div>
    </div>
  </div>
</AdminLayout>

---
/**
 * ADMIN DASHBOARD — Overview page
 * Shows key metrics: invitations, guests, RSVPs, wishes.
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';

// TODO: Replace with real data from service when auth is integrated
// For now, query database directly for demo stats
import { db } from '@db/client';
import { invitations, guests, rsvps, wishes } from '@db/index';
import { count, eq, and, isNull } from 'drizzle-orm';

const ownerId = Astro.locals.adminUser!.id;
const ownerInvitations = and(eq(invitations.ownerId, ownerId), isNull(invitations.deletedAt));

const [invCount] = await db.select({ count: count() }).from(invitations).where(ownerInvitations);
const [guestCount] = await db.select({ count: count() }).from(guests)
  .innerJoin(invitations, eq(guests.invitationId, invitations.id))
  .where(and(ownerInvitations, isNull(guests.deletedAt)));
const [rsvpAttending] = await db.select({ count: count() }).from(rsvps)
  .innerJoin(guests, eq(rsvps.guestId, guests.id))
  .innerJoin(invitations, eq(guests.invitationId, invitations.id))
  .where(and(ownerInvitations, eq(rsvps.status, 'attending')));
const [rsvpDeclined] = await db.select({ count: count() }).from(rsvps)
  .innerJoin(guests, eq(rsvps.guestId, guests.id))
  .innerJoin(invitations, eq(guests.invitationId, invitations.id))
  .where(and(ownerInvitations, eq(rsvps.status, 'not_attending')));
const [wishCount] = await db.select({ count: count() }).from(wishes)
  .innerJoin(invitations, eq(wishes.invitationId, invitations.id))
  .where(and(ownerInvitations, isNull(wishes.deletedAt)));
const [wishPending] = await db.select({ count: count() }).from(wishes)
  .innerJoin(invitations, eq(wishes.invitationId, invitations.id))
  .where(and(ownerInvitations, isNull(wishes.deletedAt), eq(wishes.status, 'pending')));
---

<AdminLayout title="Dashboard" activePage="dashboard">
  {/* Stats grid */}
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <StatCard label="Undangan" value={invCount.count} color="indigo" href="/admin/invitations" />
    <StatCard label="Total Tamu" value={guestCount.count} color="green" href="/admin/guests" />
    <StatCard label="Hadir" value={rsvpAttending.count} color="amber" href="/admin/rsvp" />
    <StatCard label="Ucapan" value={wishCount.count} color="rose" href="/admin/wishes" />
  </div>

  {/* Quick actions */}
  <div class="mt-8">
    <h3 class="mb-4 text-sm font-semibold text-gray-900">Aksi Cepat</h3>
    <div class="grid gap-3 sm:grid-cols-3">
      <a href="/admin/invitations/new" class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-all hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Buat Undangan</p>
          <p class="text-xs text-gray-500">Undangan baru</p>
        </div>
      </a>
      <a href="/admin/guests/import" class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-all hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-green-50 text-green-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Import Tamu</p>
          <p class="text-xs text-gray-500">Upload dari CSV</p>
        </div>
      </a>
      <a href="/admin/wishes" class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-all hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-rose-50 text-rose-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Moderasi Ucapan</p>
          {wishPending.count > 0 && (
            <span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-xs font-medium text-rose-600">
              {wishPending.count} baru
            </span>
          )}
          {wishPending.count === 0 && (
            <p class="text-xs text-gray-500">Tidak ada yang pending</p>
          )}
        </div>
      </a>
    </div>
  </div>
</AdminLayout>

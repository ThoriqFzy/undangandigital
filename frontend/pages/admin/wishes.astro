---
/**
 * WISHES MODERATION — Approve/reject wishes
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import { db } from '@db/client';
import { wishes } from '@db/index';
import { isNull, desc, eq } from 'drizzle-orm';

const allWishes = await db
  .select()
  .from(wishes)
  .where(isNull(wishes.deletedAt))
  .orderBy(desc(wishes.createdAt));

const statusColors: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-700',
  approved: 'bg-green-100 text-green-700',
  hidden: 'bg-gray-100 text-gray-700',
};

const statusLabels: Record<string, string> = {
  pending: 'Pending',
  approved: 'Disetujui',
  hidden: 'Disembunyikan',
};

const pendingCount = allWishes.filter(w => w.status === 'pending').length;
---

<AdminLayout title="Ucapan" activePage="wishes">
  <PageHeader
    title="Moderasi Ucapan"
    subtitle={`${allWishes.length} ucapan total · ${pendingCount} menunggu moderasi`}
  />

  {/* Filter tabs */}
  <div class="mb-6 flex gap-2">
    <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-700">
      {pendingCount} Pending
    </span>
    <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-700">
      {allWishes.filter(w => w.status === 'approved').length} Disetujui
    </span>
    <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700">
      {allWishes.filter(w => w.status === 'hidden').length} Disembunyikan
    </span>
  </div>

  {allWishes.length === 0 ? (
    <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-gray-300 bg-gray-50 py-16">
      <p class="text-sm font-medium text-gray-900">Belum ada ucapan</p>
      <p class="text-xs text-gray-500">Ucapan akan muncul setelah tamu mengirim</p>
    </div>
  ) : (
    <div class="space-y-3">
      {allWishes.map(wish => (
        <div class={`rounded-xl border bg-white p-4 shadow-sm ${
          wish.status === 'pending' ? 'border-amber-200' : 'border-gray-200'
        }`}>
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-50 text-xs font-semibold text-indigo-600">
                  {wish.name.charAt(0).toUpperCase()}
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900">{wish.name}</p>
                  <p class="text-[10px] text-gray-400">
                    {new Date(wish.createdAt).toLocaleString('id-ID')}
                  </p>
                </div>
                <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${statusColors[wish.status]}`}>
                  {statusLabels[wish.status]}
                </span>
              </div>
              <p class="mt-2 text-sm text-gray-600">{wish.message}</p>
            </div>
          </div>
          {wish.status === 'pending' && (
            <div class="mt-3 flex gap-2 border-t border-gray-100 pt-3">
              <button
                class="moderate-btn inline-flex items-center gap-1 rounded-lg bg-green-50 px-3 py-1.5 text-xs font-medium text-green-700 hover:bg-green-100"
                data-wish-id={wish.id}
                data-action="approved"
              >
                ✓ Setujui
              </button>
              <button
                class="moderate-btn inline-flex items-center gap-1 rounded-lg bg-gray-50 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100"
                data-wish-id={wish.id}
                data-action="hidden"
              >
                ✕ Sembunyikan
              </button>
            </div>
          )}
        </div>
      ))}
    </div>
  )}
</AdminLayout>

<script>
  document.querySelectorAll('.moderate-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const wishId = btn.getAttribute('data-wish-id');
      const action = btn.getAttribute('data-action');
      if (!wishId || !action) return;

      try {
        const res = await fetch(`/api/admin/wishes/${wishId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: action }),
        });
        if (res.ok) {
          window.location.reload();
        }
      } catch (e) {
        console.error('Moderation failed:', e);
      }
    });
  });
</script>

---
/**
 * RSVP MANAGEMENT — View all RSVPs
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import { db } from '@db/client';
import { rsvps, guests, invitations } from '@db/index';
import { eq, and, isNull, desc } from 'drizzle-orm';

const ownerId = Astro.locals.adminUser!.id;
const allRsvps = await db
  .select({
    id: rsvps.id,
    status: rsvps.status,
    guestCount: rsvps.guestCount,
    message: rsvps.message,
    submittedAt: rsvps.submittedAt,
    guestName: guests.name,
    guestPhone: guests.phone,
  })
  .from(rsvps)
  .leftJoin(guests, eq(rsvps.guestId, guests.id))
  .innerJoin(invitations, eq(guests.invitationId, invitations.id))
  .where(and(eq(invitations.ownerId, ownerId), isNull(invitations.deletedAt)))
  .orderBy(desc(rsvps.submittedAt));

const statusColors: Record<string, string> = {
  attending: 'bg-green-100 text-green-700',
  not_attending: 'bg-red-100 text-red-700',
  maybe: 'bg-amber-100 text-amber-700',
};

const statusLabels: Record<string, string> = {
  attending: 'Hadir',
  not_attending: 'Tidak Hadir',
  maybe: 'Ragu',
};

const totalAttending = allRsvps.filter(r => r.status === 'attending').reduce((sum, r) => sum + r.guestCount, 0);
---

<AdminLayout title="RSVP" activePage="rsvp">
  <PageHeader
    title="Konfirmasi Kehadiran"
    subtitle={`${allRsvps.length} jawaban · ${totalAttending} tamu akan hadir`}
  />

  {/* Stats bar */}
  <div class="mb-6 grid grid-cols-3 gap-3">
    <div class="rounded-lg bg-green-50 p-3 text-center">
      <p class="text-lg font-bold text-green-700">{allRsvps.filter(r => r.status === 'attending').length}</p>
      <p class="text-xs text-green-600">Hadir</p>
    </div>
    <div class="rounded-lg bg-red-50 p-3 text-center">
      <p class="text-lg font-bold text-red-700">{allRsvps.filter(r => r.status === 'not_attending').length}</p>
      <p class="text-xs text-red-600">Tidak Hadir</p>
    </div>
    <div class="rounded-lg bg-amber-50 p-3 text-center">
      <p class="text-lg font-bold text-amber-700">{allRsvps.filter(r => r.status === 'maybe').length}</p>
      <p class="text-xs text-amber-600">Ragu</p>
    </div>
  </div>

  {allRsvps.length === 0 ? (
    <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-gray-300 bg-gray-50 py-16">
      <p class="text-sm font-medium text-gray-900">Belum ada RSVP</p>
      <p class="text-xs text-gray-500">RSVP akan muncul setelah tamu mengisi form</p>
    </div>
  ) : (
    <div class="space-y-3">
      {allRsvps.map(rsvp => (
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-gray-900">{rsvp.guestName || 'Anonymous'}</p>
              {rsvp.guestPhone && <p class="text-xs text-gray-500">{rsvp.guestPhone}</p>}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-500">{rsvp.guestCount} orang</span>
              <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${statusColors[rsvp.status]}`}>
                {statusLabels[rsvp.status]}
              </span>
            </div>
          </div>
          {rsvp.message && (
            <p class="mt-2 text-sm text-gray-600 italic">&ldquo;{rsvp.message}&rdquo;</p>
          )}
          <p class="mt-2 text-[10px] text-gray-400">
            {rsvp.submittedAt ? new Date(rsvp.submittedAt).toLocaleString('id-ID') : ''}
          </p>
        </div>
      ))}
    </div>
  )}
</AdminLayout>

{
  "name": "wedding-platform",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx backend/db/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "astro check",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist/ --project-name=wedding-platform",
    "deploy:preview": "wrangler pages deploy dist/ --project-name=wedding-platform --branch=preview",
    "setup-env": "bash scripts/setup-env.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/react": "^6.0.4",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@neondatabase/serverless": "^0.10.0",
    "astro": "^7.2.7",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.1.1",
    "nanoid": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
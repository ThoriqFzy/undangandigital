/**
 * Wrangler Configuration — Cloudflare Pages
 * 
 * Deploy command: wrangler pages deploy dist/
 * Or: npm run deploy
 */

{
  "name": "wedding-platform",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  
  // Pages deployment
  "pages_build_output_dir": "dist/",
  
  // Environment variables (set via wrangler pages secret put)
  // DATABASE_URL, BETTER_AUTH_SECRET, R2_* keys
}

# ========================================
# ENVIRONMENT VARIABLES — Wedding Platform
# ========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# ========================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/wedding_platform?sslmode=require

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=change-me-to-random-secret
BETTER_AUTH_URL=http://localhost:4321

# --- R2 Object Storage (Cloudflare) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=wedding-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Application ---
PUBLIC_SITE_URL=http://localhost:4321
NODE_ENV=development

# --- Registration policy ---
# Public self-service signup is OFF unless this is exactly "true".
ALLOW_PUBLIC_REGISTRATION=false
